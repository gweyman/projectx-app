+import { PHASES, generateWeekSchedule } from './algorithm';
+
+const DAY_INDEX = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
+
+function phaseFromGoal(goal) {
+  switch (goal) {
+    case 'In-season maintenance — stay healthy':
+      return PHASES.IN_SEASON;
+    case 'Bullpen development — improve on mound':
+      return PHASES.BULLPEN;
+    case 'Build up arm — ramp-up from time off':
+    case 'Velocity development — add mph':
+    default:
+      return PHASES.BUILDUP;
+  }
+}
+
+function slotsFromDaysPerWeek(daysPerWeek) {
+  const map = {
+    '3 days': 3, '4 days': 4, '5 days': 5, '6 days': 6, '7 days': 7,
+  };
+  return map[daysPerWeek] || 4; // 'It varies' or missing -> default 4
+}
+
+// Build the next N calendar dates, preferring the athlete's selected
+// available days (Mon/Tue/etc). Falls back to the next N days if no
+// days were selected or not enough matches are found in a 2-week window.
+function nextAvailableDates(count, availableDays = []) {
+  const wanted = new Set(availableDays.map(d => DAY_INDEX[d]).filter(d => d !== undefined));
+  const dates = [];
+  const cursor = new Date();
+  cursor.setDate(cursor.getDate() + 1); // start tomorrow
+
+  for (let i = 0; i < 21 && dates.length < count; i++) {
+    const d = new Date(cursor);
+    d.setDate(cursor.getDate() + i);
+    if (wanted.size === 0 || wanted.has(d.getDay())) {
+      dates.push(d);
+    }
+  }
+  return dates.slice(0, count);
+}
+
+/**
+ * Turn a saved intake profile row into an initial week schedule.
+ * This is the "backend build" step that runs right after intake submit.
+ */
+export function buildInitialProgram(profile) {
+  const phase = phaseFromGoal(profile.goal);
+  const availableSlots = slotsFromDaysPerWeek(profile.days_per_week);
+  const availableDates = nextAvailableDates(availableSlots, profile.available_days || []);
+
+  const result = generateWeekSchedule({
+    phase,
+    availableSlots,
+    availableDates,
+  });
+
+  return {
+    phase,
+    weekInPhase: 1,
+    generatedAt: new Date().toISOString(),
+    schedule: result.schedule.map(s => ({
+      date: s.date.toISOString(),
+      dayType: s.dayType,
+    })),
+    valid: result.valid,
+    message: result.message || null,
+    neverDoViolations: result.neverDoViolations || [],
+  };
+}
